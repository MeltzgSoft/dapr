{:dapr/cache    {}
 ;; :ui holds deployment knobs the views render from, kept here rather than
 ;; compiled into the view code. :fallback-seconds is how often a region
 ;; re-fetches itself when no server notification arrives — the safety net for a
 ;; dropped event stream, not the mechanism (see dapr.web.events).
 :dapr/state    {:cache #ig/ref :dapr/cache
                 :ui    {:fallback-seconds 15}}
 ;; Bounded derived-order cache for the virtual track table. It holds only track
 ;; keys and is invalidated naturally by the catalog version in each cache key.
 :dapr/track-index {:max-entries 16}
 ;; Configure logging once the state atom exists but before anything starts
 ;; scanning, so file + live-log output captures everything from launch.
 :dapr/log      {:cache #ig/ref :dapr/cache :state-atom #ig/ref :dapr/state}
 ;; Halt-only component: closes the SMB FileSystem cache and the MTP device bridge on
 ;; shutdown. The server refs it so it halts *after* the UI (and any scan) is down.
 :dapr/devices  {}
 ;; Per-device locks arbitrating the background refresh against foreground user ops.
 :dapr/coordinator {}
 ;; Hot-plug monitor. Each MTP probe acquires and releases a short bridge session;
 ;; no device connection is retained between turns. It waits behind active work.
 :dapr/availability {:state-atom      #ig/ref :dapr/state
                     :coordinator     #ig/ref :dapr/coordinator
                     :devices         #ig/ref :dapr/devices
                     :interval-millis 5000}
 ;; The background library refresher. Refs :dapr/devices so it halts *before* the
 ;; device sessions it scans through are closed, and :dapr/coordinator so the locks
 ;; it takes outlive it. :workers sizes the pool: libraries on *different* devices
 ;; refresh at once, while one device is still walked a library at a time.
 :dapr/refresher {:state-atom  #ig/ref :dapr/state
                  :cache       #ig/ref :dapr/cache
                  :coordinator #ig/ref :dapr/coordinator
                  :devices     #ig/ref :dapr/devices
                  :workers     2}
 ;; The web UI. Loopback-only by default: the endpoints act on the user's own
 ;; devices with no authentication, so they have no business on the network.
 ;; dapr.main overrides :host/:port/:open-browser? from the command line or the
 ;; DAPR_HOST / DAPR_PORT / DAPR_NO_BROWSER environment variables.
 :dapr/server {:state-atom     #ig/ref :dapr/state
               :cache          #ig/ref :dapr/cache
               :track-index    #ig/ref :dapr/track-index
               :log            #ig/ref :dapr/log
               :refresher      #ig/ref :dapr/refresher
               :availability   #ig/ref :dapr/availability
               :devices        #ig/ref :dapr/devices
               :host           "127.0.0.1"
               :port           7373
               :open-browser?  true
               ;; Server-sent event publisher (dapr.web.events). :coalesce-millis
               ;; is how long a burst of state writes settles before one
               ;; notification goes out — a scan writes far too often to push
               ;; every change. :heartbeat-millis is the idle gap after which a
               ;; comment line is sent, which both keeps the connection alive and
               ;; is how a browser that vanished gets pruned.
               :events         {:coalesce-millis  100
                                :heartbeat-millis 25000}}}
