{:paths ["src" "resources"]

 :deps
 {org.clojure/clojure   {:mvn/version "1.12.5"}
  integrant/integrant   {:mvn/version "1.0.1"}
  ;; MTP device support via melt-jfs (Maven Central). Needs native libmtp/WPD
  ;; access at runtime, enabled by --enable-native-access=ALL-UNNAMED in the
  ;; :run and :dev aliases. 0.2.0 also ships device-agnostic audio-tag header
  ;; parsers (org.meltzg.fs.mtp.audio.AudioTagReaders over a RangedByteSource);
  ;; the smb:// reader backs one with a seekable channel to read embedded tags
  ;; from a few KB of header rather than transferring whole files (see
  ;; dapr.device.smb.tag).
  io.github.meltzg/melt-jfs {:mvn/version "0.2.3"}
  ;; SMB/CIFS share support. smb-nio registers a java.nio "smb://"
  ;; FileSystemProvider (jcifs-ng backed), so the sync engine reaches SMB shares
  ;; through the same NIO code as file:// and mtp://. java-keyring stores share
  ;; credentials in the OS keystore (Linux Secret Service/KWallet, macOS Keychain,
  ;; Windows Credential Manager) so no password is ever written to libraries.edn;
  ;; on Linux it reaches the keystore over D-Bus via JNA, so credential reads/writes
  ;; also rely on --enable-native-access=ALL-UNNAMED (set in :run and :dev).
  ch.pontius.nio/smb-nio              {:mvn/version "0.13.0"}
  com.github.javakeyring/java-keyring {:mvn/version "1.0.4"}
  ;; Audio tag reading (ID3/Vorbis/MP4/etc.) for the local file:// device. Reads
  ;; from a java.io.File, so it only applies to the default filesystem provider;
  ;; smb:// and mtp:// read embedded tags over ranged reads via melt-jfs instead
  ;; (see dapr.device.smb.tag / dapr.device.mtp.tag / dapr.device.tag).
  net.jthink/jaudiotagger             {:mvn/version "3.0.1"}
  ;; In-memory Datalog DB (Clojars) used as the persisted scan cache and the
  ;; system of record for libraries. Snapshotted to an EDN file (see dapr.cache);
  ;; pure-JVM, so it needs no extra native-access flags.
  datascript/datascript               {:mvn/version "1.8.1"}
  ;; Structured logging: file output + an in-memory ring buffer feeding the live
  ;; activity panel (see dapr.log). Clojure-native, so no SLF4J/logback wiring.
  com.taoensso/telemere               {:mvn/version "1.4.0"}

  ;; --- web UI ----------------------------------------------------------------
  ;; The UI is a local web app (see dapr.web.*): the server renders HTML, HTMX
  ;; swaps fragments of it, and no application state lives in the browser. That
  ;; also makes the UI embeddable — an Electron shell only has to point a
  ;; BrowserWindow at the local server.
  ;;
  ;; http-kit is the Ring adapter: one small jar, no servlet container and no
  ;; SLF4J backend to configure, which matters for a desktop app shipped as a
  ;; single uberjar. reitit-ring routes (the house convention), ring-core
  ;; supplies the params/keyword middleware and resource responses, and hiccup
  ;; renders the views — which stay pure data-in/HTML-out, as the cljfx views
  ;; were.
  http-kit/http-kit    {:mvn/version "2.8.1"}
  metosin/reitit-ring  {:mvn/version "0.10.1"}
  ;; reitit-ring pulls an older ring-core; pin the current one explicitly rather
  ;; than inherit whatever it happens to depend on.
  ring/ring-core       {:mvn/version "1.15.5"}
  hiccup/hiccup        {:mvn/version "2.0.0"}
  ;; htmx itself, as a WebJar rather than a checked-in copy: the js is a build
  ;; artifact of someone else's project, so it is resolved like any other
  ;; dependency and lands in the uberjar at build time. dapr.web.assets finds
  ;; the scripts on the classpath (each version read from its WebJar's
  ;; pom.properties) and serves them from /assets/.
  org.webjars.npm/htmx.org     {:mvn/version "4.0.0"}
  ;; The SSE extension, for the pushed region notifications (dapr.web.events).
  ;; Deliberately NOT the copy bundled at htmx.org's own dist/ext/sse.js: that
  ;; one is the htmx 1.x extension, left in the npm package for compatibility.
  ;; It opens the connection under htmx 2 but never fires `hx-trigger="sse:…"`,
  ;; so every region silently fell back to its timer — which looks exactly like
  ;; a slow app rather than a broken one. htmx 2 moved extensions to packages of
  ;; their own; this is that package.
  org.webjars.npm/htmx-ext-sse {:mvn/version "2.2.4"}
  ;; Idiomorph, as htmx's `morph` swap. The live regions (status strip, jobs,
  ;; log) are re-rendered as often as once a second while a scan runs, and
  ;; replacing an element throws away the state the DOM owns rather than the
  ;; server: a CSS animation restarts from frame 0, and a scroll position resets.
  ;; Morphing patches the existing nodes in place instead, so the spinner keeps
  ;; spinning and the log keeps the reader's place.
  org.webjars.npm/idiomorph     {:mvn/version "0.7.4"}
  ;; Command-line parsing for dapr.main's --port/--host/--no-browser, so the flags
  ;; are validated and the --help summary generated rather than hand-rolled.
  org.clojure/tools.cli        {:mvn/version "1.4.256"}}

 :aliases
 {;; Run the app: starts the local web server and opens the UI in a browser.
  ;; DAPR_PORT / --port choose the port (default 7373); DAPR_NO_BROWSER=1
  ;; suppresses the browser launch (what an Electron shell wants).
  :run
  {:main-opts ["-m" "dapr.main"]
   :jvm-opts  ["--enable-native-access=ALL-UNNAMED"]}

  ;; REPL-driven development with integrant.repl (go / reset / halt).
  :dev
  {:extra-paths ["dev/src" "test"]
   :extra-deps  {integrant/repl {:mvn/version "0.5.1"}}
   :jvm-opts    ["--enable-native-access=ALL-UNNAMED"]}

  :outdated     {:deps      {com.github.liquidz/antq {:mvn/version "2.11.1276"}}
                 :main-opts ["-m" "antq.core"]}

  ;; Unit + hermetic tests.
  :test
  {:extra-paths ["test"]
   :extra-deps  {io.github.cognitect-labs/test-runner {:git/tag "v0.5.1" :git/sha "dfb30dd"}
                 com.google.jimfs/jimfs               {:mvn/version "1.3.2"}}
   :main-opts   ["-m" "cognitect.test-runner"]
   :exec-fn     cognitect.test-runner.api/test}

  ;; Integration tests against filesystem backends (test-integration/). Kept out
  ;; of the default :test suite. `clojure -M:integration`. The NIO tests use jimfs
  ;; for real in-memory FileSystem coverage; live backend tests skip unless their
  ;; backend is available: SMB spins up Samba with Testcontainers (needs Docker),
  ;; and MTP runs only when a real device is attached. CI (integration.yml) just
  ;; runs this alias; SMB exercises on Linux, MTP skips without hardware.
  ;; --enable-native-access is for melt-jfs's native MTP discovery (as in
  ;; :run/:dev). Uses :main-opts (not :exec-fn) so cognitect.test-runner's -main
  ;; calls System/exit — both to signal pass/fail to CI and to force the JVM down
  ;; past any non-daemon threads a client leaves running (e.g. an open SMB
  ;; FileSystem's jcifs connection threads).
  :integration
  {:extra-paths ["test-integration" "test"]
   :extra-deps  {io.github.cognitect-labs/test-runner {:git/tag "v0.5.1" :git/sha "dfb30dd"}
                 com.google.jimfs/jimfs               {:mvn/version "1.3.2"}
                 ;; Manages each backend's service container from a :once fixture.
                 org.testcontainers/testcontainers     {:mvn/version "2.0.5"}}
   :jvm-opts    ["--enable-native-access=ALL-UNNAMED"]
   :main-opts   ["-m" "cognitect.test-runner" "-d" "test-integration"]}

  ;; Formatting. dev/src is kept off the classpath (lint/format it by passing it as
  ;; a path arg) so Clojure doesn't auto-load dev/src/user.clj — whose integrant.repl
  ;; require isn't on this alias — at startup.
  :cljfmt
  {:extra-paths ["test" "test-integration"]
   :extra-deps  {dev.weavejester/cljfmt {:mvn/version "0.16.5"}}
   :main-opts   ["-m" "cljfmt.main"]}

  ;; Linting. dev/src kept off the classpath for the same reason as :cljfmt above.
  :clj-kondo
  {:extra-paths ["test" "test-integration"]
   :extra-deps  {clj-kondo/clj-kondo {:mvn/version "2026.08.04"}}
   :main-opts   ["-m" "clj-kondo.main"]}

  ;; Release build: `clojure -T:build uber` produces an AOT uberjar for
  ;; dapr.main. One jar runs everywhere now that the UI is HTML rather than
  ;; JavaFX — nothing on the classpath ships per-OS natives (the MTP and keystore
  ;; backends bind to the host's own libraries at runtime).
  :build
  {:deps      {io.github.clojure/tools.build {:mvn/version "0.10.14"}}
   :ns-default build}}}
