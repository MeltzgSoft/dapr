# Browser e2e tests (see e2e/README.md): installed deps, the seeded scratch
# library and config dir the suite runs against, and Playwright's own output.
# None of it is source — node_modules alone is thousands of vendored files.
/e2e/node_modules/
/e2e/.tmp/
/e2e/test-results/
/e2e/playwright-report/
/e2e/blob-report/
/e2e/.cache/

# Electron shell (see electron/README.md): installed deps, the jar staged into
# the packaged app, and electron-builder's output.
/electron/node_modules/
/electron/resources/
/electron/dist/
